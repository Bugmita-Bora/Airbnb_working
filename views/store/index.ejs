<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    
    <main class="p-6">
      <h2 class="text-3xl text-red-500 font-bold text-center mb-6">
        Welcome to AIRBNB homepage
      </h2>

      <div class="grid grid-cols-3 gap-6">
        <% registeredHomes.forEach(home => { %>
          <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition duration-300">
            
            <img src="<%= home.photoUrl %>"  alt="<%= home.houseName %>"
                 class="w-full h-56 object-cover">

            <div class="p-4 flex flex-col gap-2">
              <div class="flex justify-between items-start">
                <h3 class="text-lg font-semibold text-gray-800"><%= home.houseName %></h3>
                <span class="bg-green-100 text-green-800 text-sm px-3 py-1 rounded">
                  &#9733; <%= home.rating %>
                </span>
              </div>
              <p class="text-gray-500 text-sm"><%= home.location %></p>
              <p class="text-lg font-semibold text-gray-800">
                Rs <%= home.price %> <span class="text-sm font-normal text-gray-400">/ night</span>
              </p>
              <div class="flex gap-2 mt-2">
                <a href="/homes/<%= home.id %>" class="bg-blue-100 text-blue-800 text-sm px-4 py-2 rounded">Details</a>
                <button class="bg-green-100 text-green-800 text-sm px-4 py-2 rounded">Book</button>
              </div>
            </div>

          </div>
        <% }) %>
      </div>

    </main>
  </body>
</html>